{
  "name": "fock-logger",
  "version": "7.0.1",
  "description": "Simple logger for your pet-project",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./config": {
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs",
      "types": "./dist/types/config/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build",
    "htmldocs": "typedoc --out htmldocs src/index.ts"
  },
  "keywords": [],
  "author": {
    "name": "FOCKUSTY",
    "email": "viserd.yt@gmail.com",
    "url": "https://fockusty.vercel.app"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  },
  "engines": {
    "node": ">=7.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FOCKUSTY/logger"
  },
  "bugs": {
    "email": "wwddwwwd@mail.ru",
    "url": "https://github.com/FOCKUSTY/logger/issues"
  }
}
